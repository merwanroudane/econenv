cff-version: 1.2.0
title: "EconEnv: Python, R, Stata and EViews in one reproducible Jupyter workflow"
message: "If you use EconEnv in your research, please cite it as below."
type: software
authors:
  - family-names: Roudane
    given-names: Merwan
    email: merwanroudane920@gmail.com
    orcid: ""
