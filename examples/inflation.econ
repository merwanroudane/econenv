# A first EconLang program.
#
# Run it with:
#     econenv.lang.run_file("examples/inflation.econ")
#
# or in a notebook, paste the body into a %%econlang cell.
#
# The point of the language: you state the model once, and change only
# `engine =` to run it somewhere else. Nothing here is Python, R or Stata
# syntax — it is the econometrics, and EconEnv writes the rest.

project "inflation-study"

# python is always available; try r, stata, eviews, matlab or gauss
backend = python

data "macro.csv"

# Declaring the time index makes EconEnv check it: duplicates are refused,
# gaps and unsorted rows are reported rather than silently estimated over.
set time:
    variable = year
    frequency = quarterly

# The baseline. `y` is the dependent variable, `x` the regressors.
model ols baseline:
    y = gdp
    x = inflation, unemployment

# The same specification with heteroskedasticity-robust standard errors.
# Only the covariance changes, so the two are directly comparable.
model ols robust_se:
    y = gdp
    x = inflation, unemployment
    vcov = HC3

# Say what the model is, in words rather than syntax.
explain baseline

# Show the native code that will actually run — not a prettified version of
# it. This is the same text the engine receives.
show code baseline
show code robust_se

# And the same model in every backend at once, generated by the same
# compilers that execute it, so the table cannot drift from what runs.
translate robust_se
